# IRONX - Production Firebase Environment Configuration
# Duplicate this file to .env.local and populate with your Firebase Project credentials.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Enable Development Sandbox Role Switcher (set to "false" in production builds)
VITE_ENABLE_DEMO_AUTH="true"

# Paddle Sandbox Client Configuration (Client Token only; NEVER place API secrets here)
VITE_PADDLE_ENVIRONMENT="sandbox"
VITE_PADDLE_CLIENT_TOKEN=""

